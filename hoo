"""
nano_qwen — a dependency-free (numpy-only) inference engine for Qwen2 models.

Why this exists
---------------
The sandbox has no torch/transformers and PyPI is blocked, but huggingface.co is
reachable.  So we implement just enough of the Qwen2 architecture to run
Qwen2.5-0.5B-Instruct as a *real teacher* on CPU:

  * safetensors reader (pure python header parse + mmap)
  * bf16 -> fp32 flat-cache converter (keeps RAM under control on a 3 GB box)
  * byte-level BPE tokenizer (GPT-2 style, Qwen's pretokenizer regex)
  * Qwen2 forward pass: RMSNorm, GQA attention, RoPE, SwiGLU, tied embeddings
  * greedy decoding with a KV cache

Everything is numpy.  No torch.  No network at inference time.
"""
from .tokenizer import QwenTokenizer
from .model import Qwen2, GenerationConfig

__all__ = ["QwenTokenizer", "Qwen2", "GenerationConfig"]
