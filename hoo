"""
Pure-numpy Qwen2 inference (RMSNorm + GQA + RoPE + SwiGLU + tied embeddings).

Weights live in a single flat fp32 file (converted once from the bf16
safetensors) which is memory-mapped, so a 3 GB box can run a 0.5B model.
"""
from __future__ import annotations

import json
import os
import re
import struct
from dataclasses import dataclass

import numpy as np

# --------------------------------------------------------------------------
# safetensors -> flat fp32 cache
# --------------------------------------------------------------------------
def _read_safetensors_header(path: str) -> tuple[dict, int]:
    with open(path, "rb") as f:
        n = struct.unpack("<Q", f.read(8))[0]
        hdr = json.loads(f.read(n))
    return hdr, 8 + n


def build_fp32_cache(safetensors_path: str, cache_dir: str) -> str:
    """Convert every BF16 tensor into one flat fp32 file + index.json."""
    os.makedirs(cache_dir, exist_ok=True)
    idx_path = os.path.join(cache_dir, "index.json")
    bin_path = os.path.join(cache_dir, "model_fp32.bin")
    if os.path.exists(idx_path) and os.path.exists(bin_path):
        return cache_dir
    hdr, data_start = _read_safetensors_header(safetensors_path)
    index = {}
    offset = 0
    with open(safetensors_path, "rb") as src, open(bin_path, "wb") as dst:
        for name, meta in hdr.items():
            if name == "__metadata__":
                continue
            s, e = meta["data_offsets"]
            src.seek(data_start + s)
            raw = src.read(e - s)
            if meta["dtype"] == "BF16":
                u16 = np.frombuffer(raw, dtype=np.uint16).reshape(meta["shape"])
                bits = (u16.astype(np.uint32) << 16)
                arr = bits.view(np.float32)
            elif meta["dtype"] == "F32":
                arr = np.frombuffer(raw, dtype=np.float32).reshape(meta["shape"])
            elif meta["dtype"] == "F16":
                arr = np.frombuffer(raw, dtype=np.float16).reshape(meta["shape"]).astype(np.float32)
            else:
                raise ValueError(f"unsupported dtype {meta['dtype']}")
            tr = bool(re.match(r"model\.layers\.\d+\.(self_attn\.(q|k|v|o)_proj|mlp\.(gate|up|down)_proj)\.weight$", name))
            if tr:
                arr = arr.T
            dst.write(np.ascontiguousarray(arr, dtype=np.float32).tobytes())
            index[name] = {"offset": offset, "shape": list(arr.shape), "transposed": tr}
            offset += arr.size * 4
    with open(idx_path, "w") as f:
        json.dump(index, f)
    return cache_dir


@dataclass
class GenerationConfig:
    max_new_tokens: int = 16
    temperature: float = 0.0     # 0 = greedy
    stop: tuple = ()
    system: str | None = None


class Qwen2:
    def __init__(self, model_dir: str, cache_dir: str | None = None):
        self.model_dir = model_dir
        with open(os.path.join(model_dir, "config.json")) as f:
            self.cfg = json.load(f)
        st = os.path.join(model_dir, "model.safetensors")
        cache_dir = cache_dir or os.path.join(model_dir, "_fp32cache")
        build_fp32_cache(st, cache_dir)
        with open(os.path.join(cache_dir, "index.json")) as f:
            self.index = json.load(f)
        self._mm = np.memmap(os.path.join(cache_dir, "model_fp32.bin"), dtype=np.float32, mode="r")
        c = self.cfg
        self.n_layer = c["num_hidden_layers"]
        self.n_head = c["num_attention_heads"]
        self.n_kv = c["num_key_value_heads"]
        self.hidden = c["hidden_size"]
        self.head_dim = self.hidden // self.n_head
        self.eps = c["rms_norm_eps"]
        self.theta = c["rope_theta"]
        self.n_rep = self.n_head // self.n_kv
        self._rope_cache = {}

    def w(self, name: str) -> np.ndarray:
        meta = self.index[name]
        off = meta["offset"] // 4
        return np.asarray(self._mm[off: off + int(np.prod(meta["shape"]))]).reshape(meta["shape"])

    def rmsnorm(self, x: np.ndarray, weight: np.ndarray) -> np.ndarray:
        x32 = x.astype(np.float32)
        var = np.mean(x32 * x32, axis=-1, keepdims=True)
        return (x32 / np.sqrt(var + self.eps)) * weight

    def rope(self, x: np.ndarray, positions: np.ndarray) -> np.ndarray:
        B, T = x.shape[0], x.shape[1]
        d = self.head_dim
        inv = 1.0 / (self.theta ** (np.arange(0, d, 2, dtype=np.float32) / d))
        freqs = positions.astype(np.float32)[:, :, None] * inv[None, None, :]
        emb = np.concatenate([freqs, freqs], axis=-1)
        cos, sin = np.cos(emb), np.sin(emb)
        x1 = x[..., : d // 2]
        x2 = x[..., d // 2:]
        rot = np.concatenate([-x2, x1], axis=-1)
        return x * cos[:, :, None, :] + rot * sin[:, :, None, :]

    def forward(self, ids: np.ndarray, attn_mask: np.ndarray | None = None,
                position_ids: np.ndarray | None = None, cache: list | None = None):
        B, T = ids.shape
        h = self.w("model.embed_tokens.weight")[ids].astype(np.float32)
        if cache is None:
            cache = {"k": [None] * self.n_layer, "v": [None] * self.n_layer, "pos": None}
        if position_ids is None:
            position_ids = np.arange(T, dtype=np.int64)[None, :].repeat(B, 0)
        if attn_mask is None:
            attn_mask = np.ones((B, T), dtype=np.float32)
        past = 0 if cache["k"][0] is None else cache["k"][0].shape[1]
        if cache["pos"] is None:
            kpos_all = position_ids.copy()
        else:
            kpos_all = np.concatenate([cache["pos"], position_ids], axis=1)
        for li in range(self.n_layer):
            p = f"model.layers.{li}."
            x = self.rmsnorm(h, self.w(p + "input_layernorm.weight"))
            x2 = x.reshape(B * T, self.hidden)

            q = x2 @ self.w(p + "self_attn.q_proj.weight") + self.w(p + "self_attn.q_proj.bias")
            k = x2 @ self.w(p + "self_attn.k_proj.weight") + self.w(p + "self_attn.k_proj.bias")
            v = x2 @ self.w(p + "self_attn.v_proj.weight") + self.w(p + "self_attn.v_proj.bias")

            q = q.reshape(B, T, self.n_head, self.head_dim)
            k = k.reshape(B, T, self.n_kv, self.head_dim)
            v = v.reshape(B, T, self.n_kv, self.head_dim)
            q = self.rope(q, position_ids)
            k = self.rope(k, position_ids)

            if cache["k"][li] is not None:
                k = np.concatenate([cache["k"][li], k], axis=1)
                v = np.concatenate([cache["v"][li], v], axis=1)
            cache["k"][li], cache["v"][li] = k, v
            K, V = k, v
            S = K.shape[1]
            if self.n_rep > 1:
                K = np.repeat(K, self.n_rep, axis=2)
                V = np.repeat(V, self.n_rep, axis=2)

            qh = q.transpose(0, 2, 1, 3)
            Kh = K.transpose(0, 2, 3, 1)
            Vh = V.transpose(0, 2, 1, 3)
            att = np.matmul(qh, Kh) / np.sqrt(self.head_dim)

            qpos = position_ids[:, :, None].astype(np.float32)
            kpos = kpos_all.astype(np.float32)[:, None, :]
            causal = np.where(kpos > qpos, -1e30, 0.0)
            att = att + causal[:, None, :, :]
            pad = attn_mask if past == 0 else np.concatenate(
                [np.ones((B, past), dtype=np.float32), attn_mask], axis=1)
            att = att + np.where(pad > 0, 0.0, -1e30)[:, None, None, :]
            att -= att.max(axis=-1, keepdims=True)
            att = np.exp(att)
            att /= att.sum(axis=-1, keepdims=True)
            out = np.matmul(att, Vh).transpose(0, 2, 1, 3).reshape(B * T, self.hidden)
            h = h + (out @ self.w(p + "self_attn.o_proj.weight")).reshape(B, T, self.hidden)

            x = self.rmsnorm(h, self.w(p + "post_attention_layernorm.weight"))
            x2 = x.reshape(B * T, self.hidden)
            gate = x2 @ self.w(p + "mlp.gate_proj.weight")
            up = x2 @ self.w(p + "mlp.up_proj.weight")
            act = gate / (1.0 + np.exp(-gate)) * up
            h = h + (act @ self.w(p + "mlp.down_proj.weight")).reshape(B, T, self.hidden)

        cache["pos"] = kpos_all
        h = self.rmsnorm(h, self.w("model.norm.weight"))
        last = h[:, -1]
        logits = (self.w("model.embed_tokens.weight") @ last.T).T
        return logits, cache

    def generate_batch(self, seqs: list[list[int]], cfg: GenerationConfig,
                       batch_size: int = 16):
        results: list[list[int]] = []
        eos = (151643, 151645)
        for start in range(0, len(seqs), batch_size):
            chunk = seqs[start: start + batch_size]
            ids, mask, pos = self._pad_batch(chunk)
            logits, cache = self.forward(ids, mask, pos)
            done = np.zeros(len(chunk), dtype=bool)
            outs = [[] for _ in chunk]
            cur_pos = pos[:, -1].copy()
            for step in range(cfg.max_new_tokens):
                nxt = np.argmax(logits, axis=-1)
                for i in range(len(chunk)):
                    if not done[i]:
                        if nxt[i] in eos:
                            done[i] = True
                        else:
                            outs[i].append(int(nxt[i]))
                if done.all():
                    break
                cur_pos = cur_pos + 1
                step_mask = np.ones((len(chunk), 1), dtype=np.float32)
                logits, cache = self.forward(nxt[:, None], step_mask,
                                             cur_pos[:, None], cache)
            results.extend(outs)
        return results

    def generate(self, prompt_ids: list[int], cfg: GenerationConfig):
        return self.generate_batch([prompt_ids], cfg, batch_size=1)[0]

    def score_batch(self, prompts: list[list[int]], conts: list[list[int]]) -> list[float]:
        B = len(prompts)
        seqs = [p + c for p, c in zip(prompts, conts)]
        ids, mask, pos = self._pad_batch(seqs)
        logits, cache = self.forward(ids, mask, pos)
        lps = []
        for i, (p, c) in enumerate(zip(prompts, conts)):
            if not c:
                lps.append(0.0)
                continue
            lps.append(0.0)
        return lps
