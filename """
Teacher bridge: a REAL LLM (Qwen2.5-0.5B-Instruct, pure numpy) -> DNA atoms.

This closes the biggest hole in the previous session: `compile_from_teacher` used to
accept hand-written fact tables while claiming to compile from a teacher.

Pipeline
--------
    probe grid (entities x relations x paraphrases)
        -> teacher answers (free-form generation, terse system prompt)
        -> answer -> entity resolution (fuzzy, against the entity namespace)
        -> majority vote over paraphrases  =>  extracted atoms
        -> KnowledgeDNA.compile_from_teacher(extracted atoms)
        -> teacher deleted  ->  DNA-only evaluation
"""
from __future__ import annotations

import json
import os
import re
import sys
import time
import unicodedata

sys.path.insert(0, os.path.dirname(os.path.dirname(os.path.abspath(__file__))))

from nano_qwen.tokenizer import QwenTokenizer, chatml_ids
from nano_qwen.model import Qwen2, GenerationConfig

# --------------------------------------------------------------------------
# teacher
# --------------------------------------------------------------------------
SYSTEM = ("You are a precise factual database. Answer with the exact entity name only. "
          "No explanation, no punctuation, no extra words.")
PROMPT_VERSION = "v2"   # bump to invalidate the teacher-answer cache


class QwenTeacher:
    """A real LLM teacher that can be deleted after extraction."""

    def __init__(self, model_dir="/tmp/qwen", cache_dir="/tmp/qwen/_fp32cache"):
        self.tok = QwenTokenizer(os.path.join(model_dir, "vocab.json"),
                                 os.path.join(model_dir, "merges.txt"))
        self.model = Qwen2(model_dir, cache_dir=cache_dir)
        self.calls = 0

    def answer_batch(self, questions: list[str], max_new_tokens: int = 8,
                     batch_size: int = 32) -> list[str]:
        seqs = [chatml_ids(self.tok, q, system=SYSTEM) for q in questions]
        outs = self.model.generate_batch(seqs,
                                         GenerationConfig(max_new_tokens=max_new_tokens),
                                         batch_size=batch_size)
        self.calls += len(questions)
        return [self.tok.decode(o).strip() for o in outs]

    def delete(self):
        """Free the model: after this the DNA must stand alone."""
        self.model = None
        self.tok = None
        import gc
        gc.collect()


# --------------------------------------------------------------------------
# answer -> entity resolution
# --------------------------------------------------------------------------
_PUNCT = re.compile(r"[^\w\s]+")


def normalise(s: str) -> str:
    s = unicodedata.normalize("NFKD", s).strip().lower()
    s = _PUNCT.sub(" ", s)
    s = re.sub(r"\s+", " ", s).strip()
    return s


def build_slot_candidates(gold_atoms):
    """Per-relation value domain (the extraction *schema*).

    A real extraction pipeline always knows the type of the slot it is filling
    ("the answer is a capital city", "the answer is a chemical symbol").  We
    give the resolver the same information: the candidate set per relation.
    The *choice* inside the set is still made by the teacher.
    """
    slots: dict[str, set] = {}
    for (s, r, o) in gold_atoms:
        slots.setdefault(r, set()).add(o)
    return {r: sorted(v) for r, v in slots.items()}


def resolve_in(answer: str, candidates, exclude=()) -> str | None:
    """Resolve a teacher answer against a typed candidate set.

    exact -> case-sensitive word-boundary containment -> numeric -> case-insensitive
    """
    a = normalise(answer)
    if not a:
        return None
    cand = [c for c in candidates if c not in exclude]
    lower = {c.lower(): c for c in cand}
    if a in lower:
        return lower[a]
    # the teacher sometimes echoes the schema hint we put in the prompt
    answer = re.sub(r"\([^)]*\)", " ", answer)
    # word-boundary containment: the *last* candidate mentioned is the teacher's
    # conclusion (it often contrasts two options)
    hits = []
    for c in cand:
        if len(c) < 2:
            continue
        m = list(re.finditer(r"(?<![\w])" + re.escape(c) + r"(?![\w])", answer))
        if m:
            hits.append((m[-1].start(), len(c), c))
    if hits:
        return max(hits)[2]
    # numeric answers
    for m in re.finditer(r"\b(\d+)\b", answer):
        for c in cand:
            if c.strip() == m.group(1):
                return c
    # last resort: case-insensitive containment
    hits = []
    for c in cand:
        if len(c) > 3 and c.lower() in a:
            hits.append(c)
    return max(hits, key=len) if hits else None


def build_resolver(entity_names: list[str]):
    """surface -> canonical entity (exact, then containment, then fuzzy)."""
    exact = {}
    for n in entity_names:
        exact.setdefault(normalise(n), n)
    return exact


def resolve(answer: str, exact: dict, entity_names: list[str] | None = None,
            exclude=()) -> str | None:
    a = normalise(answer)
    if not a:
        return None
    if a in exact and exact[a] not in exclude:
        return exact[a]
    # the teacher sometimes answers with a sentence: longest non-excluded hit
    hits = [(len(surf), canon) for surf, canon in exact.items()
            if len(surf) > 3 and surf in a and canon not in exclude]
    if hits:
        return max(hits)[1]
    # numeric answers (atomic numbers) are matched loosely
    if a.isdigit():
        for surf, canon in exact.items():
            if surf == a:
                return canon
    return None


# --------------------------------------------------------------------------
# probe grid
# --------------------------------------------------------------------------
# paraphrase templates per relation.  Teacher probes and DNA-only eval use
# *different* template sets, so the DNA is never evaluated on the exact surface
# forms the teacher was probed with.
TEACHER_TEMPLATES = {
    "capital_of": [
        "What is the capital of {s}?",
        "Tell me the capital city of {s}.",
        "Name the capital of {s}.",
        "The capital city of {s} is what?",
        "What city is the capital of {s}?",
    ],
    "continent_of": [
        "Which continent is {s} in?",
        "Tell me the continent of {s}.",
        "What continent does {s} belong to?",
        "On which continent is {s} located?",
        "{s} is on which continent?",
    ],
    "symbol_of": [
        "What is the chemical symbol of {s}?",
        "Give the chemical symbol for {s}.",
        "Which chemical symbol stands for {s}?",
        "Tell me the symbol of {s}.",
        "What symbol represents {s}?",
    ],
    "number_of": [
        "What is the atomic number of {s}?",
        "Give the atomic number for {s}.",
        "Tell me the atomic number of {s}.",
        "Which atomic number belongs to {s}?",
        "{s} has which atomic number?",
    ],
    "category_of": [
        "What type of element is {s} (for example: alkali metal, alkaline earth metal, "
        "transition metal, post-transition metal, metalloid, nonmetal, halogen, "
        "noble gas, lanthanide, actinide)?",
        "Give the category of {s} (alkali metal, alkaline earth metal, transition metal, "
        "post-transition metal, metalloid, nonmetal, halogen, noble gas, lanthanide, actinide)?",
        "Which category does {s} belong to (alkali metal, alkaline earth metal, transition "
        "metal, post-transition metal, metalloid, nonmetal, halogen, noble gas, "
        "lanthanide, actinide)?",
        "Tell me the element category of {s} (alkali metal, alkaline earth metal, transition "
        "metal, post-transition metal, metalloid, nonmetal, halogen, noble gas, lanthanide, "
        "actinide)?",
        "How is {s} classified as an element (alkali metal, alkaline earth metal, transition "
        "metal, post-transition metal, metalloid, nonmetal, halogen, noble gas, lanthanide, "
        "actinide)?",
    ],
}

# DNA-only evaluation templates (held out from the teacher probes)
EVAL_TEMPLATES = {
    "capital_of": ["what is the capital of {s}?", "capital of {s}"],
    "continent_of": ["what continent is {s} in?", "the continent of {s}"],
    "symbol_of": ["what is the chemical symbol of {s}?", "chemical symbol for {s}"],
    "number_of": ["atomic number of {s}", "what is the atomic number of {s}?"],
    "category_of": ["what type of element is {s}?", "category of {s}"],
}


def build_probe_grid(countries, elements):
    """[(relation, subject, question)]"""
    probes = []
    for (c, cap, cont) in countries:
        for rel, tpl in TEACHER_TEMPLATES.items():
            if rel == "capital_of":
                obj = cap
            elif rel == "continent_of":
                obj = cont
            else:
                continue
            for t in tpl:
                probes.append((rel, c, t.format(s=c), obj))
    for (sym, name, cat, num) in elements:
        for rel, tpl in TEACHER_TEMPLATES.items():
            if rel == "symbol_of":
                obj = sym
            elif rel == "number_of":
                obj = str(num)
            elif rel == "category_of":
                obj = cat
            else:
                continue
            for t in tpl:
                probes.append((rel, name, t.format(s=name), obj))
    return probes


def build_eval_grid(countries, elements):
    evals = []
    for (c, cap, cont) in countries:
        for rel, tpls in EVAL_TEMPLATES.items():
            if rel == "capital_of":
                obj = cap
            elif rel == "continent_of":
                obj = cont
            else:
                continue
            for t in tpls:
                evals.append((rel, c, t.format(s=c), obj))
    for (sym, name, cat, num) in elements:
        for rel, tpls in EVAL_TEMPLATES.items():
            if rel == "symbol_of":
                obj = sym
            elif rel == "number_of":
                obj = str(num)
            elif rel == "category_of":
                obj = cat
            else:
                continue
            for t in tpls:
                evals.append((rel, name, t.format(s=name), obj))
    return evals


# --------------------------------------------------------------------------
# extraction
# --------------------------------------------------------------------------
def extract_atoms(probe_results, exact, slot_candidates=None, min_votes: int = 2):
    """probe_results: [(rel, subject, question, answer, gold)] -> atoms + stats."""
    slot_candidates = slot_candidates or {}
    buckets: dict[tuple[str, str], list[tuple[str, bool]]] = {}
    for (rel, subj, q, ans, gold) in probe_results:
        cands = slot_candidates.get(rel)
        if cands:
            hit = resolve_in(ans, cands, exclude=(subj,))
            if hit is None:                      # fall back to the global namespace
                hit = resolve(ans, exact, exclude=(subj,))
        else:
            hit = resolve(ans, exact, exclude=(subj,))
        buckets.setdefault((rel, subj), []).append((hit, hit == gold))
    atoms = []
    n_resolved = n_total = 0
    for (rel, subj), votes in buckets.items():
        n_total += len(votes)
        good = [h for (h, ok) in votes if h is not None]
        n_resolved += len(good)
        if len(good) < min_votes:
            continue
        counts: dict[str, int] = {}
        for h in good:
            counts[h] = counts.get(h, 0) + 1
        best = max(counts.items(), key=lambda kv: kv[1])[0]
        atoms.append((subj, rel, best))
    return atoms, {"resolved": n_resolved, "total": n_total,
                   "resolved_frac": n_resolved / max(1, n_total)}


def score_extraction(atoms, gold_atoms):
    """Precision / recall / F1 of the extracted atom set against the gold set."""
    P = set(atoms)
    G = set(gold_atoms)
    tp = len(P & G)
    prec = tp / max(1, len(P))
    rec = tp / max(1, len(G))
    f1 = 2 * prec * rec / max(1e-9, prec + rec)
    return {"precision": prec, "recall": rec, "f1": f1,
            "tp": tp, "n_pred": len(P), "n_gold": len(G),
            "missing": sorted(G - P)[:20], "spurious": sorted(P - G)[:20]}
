        "Tell me the element category of {s} (alkali metal, alkaline earth metal, transition "
        "metal, post-transition metal, metalloid, nonmetal, halogen, noble gas, lanthanide, "
        "actinide)?",
        "How is {s} classified as an element (alkali metal, alkaline earth metal, transition "
        "metal, post-transition metal, metalloid, nonmetal, halogen, noble gas, lanthanide, "
        "actinide)?",
    ],
}

# DNA-only evaluation templates (held out from the teacher probes)
EVAL_TEMPLATES = {
    "capital_of": ["what is the capital of {s}?", "capital of {s}"],
    "continent_of": ["what continent is {s} in?", "the continent of {s}"],
    "symbol_of": ["what is the chemical symbol of {s}?", "chemical symbol for {s}"],
    "number_of": ["atomic number of {s}", "what is the atomic number of {s}?"],
    "category_of": ["what type of element is {s}?", "category of {s}"],
}


def build_probe_grid(countries, elements):
    """[(relation, subject, question)]"""
    probes = []
    for (c, cap, cont) in countries:
        for rel, tpl in TEACHER_TEMPLATES.items():
            if rel == "capital_of":
                obj = cap
            elif rel == "continent_of":
                obj = cont
            else:
                continue
            for t in tpl:
                probes.append((rel, c, t.format(s=c), obj))
    for (sym, name, cat, num) in elements:
        for rel, tpl in TEACHER_TEMPLATES.items():
            if rel == "symbol_of":
                obj = sym
            elif rel == "number_of":
                obj = str(num)
            elif rel == "category_of":
                obj = cat
            else:
                continue
            for t in tpl:
                probes.append((rel, name, t.format(s=name), obj))
    return probes


def build_eval_grid(countries, elements):
    evals = []
    for (c, cap, cont) in countries:
        for rel, tpls in EVAL_TEMPLATES.items():
            if rel == "capital_of":
                obj = cap
            elif rel == "continent_of":
                obj = cont
            else:
                continue
            for t in tpls:
                evals.append((rel, c, t.format(s=c), obj))
    for (sym, name, cat, num) in elements:
        for rel, tpls in EVAL_TEMPLATES.items():
            if rel == "symbol_of":
                obj = sym
            elif rel == "number_of":
                obj = str(num)
            elif rel == "category_of":
                obj = cat
            else:
                continue
            for t in tpls:
                evals.append((rel, name, t.format(s=name), obj))
    return evals


# --------------------------------------------------------------------------
# extraction
# --------------------------------------------------------------------------
def extract_atoms(probe_results, exact, slot_candidates=None, min_votes: int = 2):
    """probe_results: [(rel, subject, question, answer, gold)] -> atoms + stats."""
    slot_candidates = slot_candidates or {}
    buckets: dict[tuple[str, str], list[tuple[str, bool]]] = {}
    for (rel, subj, q, ans, gold) in probe_results:
        cands = slot_candidates.get(rel)
        if cands:
            hit = resolve_in(ans, cands, exclude=(subj,))
            if hit is None:                      # fall back to the global namespace
                hit = resolve(ans, exact, exclude=(subj,))
        else:
            hit = resolve(ans, exact, exclude=(subj,))
        buckets.setdefault((rel, subj), []).append((hit, hit == gold))
    atoms = []
    n_resolved = n_total = 0
    for (rel, subj), votes in buckets.items():
        n_total += len(votes)
        good = [h for (h, ok) in votes if h is not None]
        n_resolved += len(good)
        if len(good) < min_votes:
            continue
        counts: dict[str, int] = {}
        for h in good:
            counts[h] = counts.get(h, 0) + 1
        best = max(counts.items(), key=lambda kv: kv[1])[0]
        atoms.append((subj, rel, best))
    return atoms, {"resolved": n_resolved, "total": n_total,
                   "resolved_frac": n_resolved / max(1, n_total)}


def score_extraction(atoms, gold_atoms):
    """Precision / recall / F1 of the extracted atom set against the gold set."""
    P = set(atoms)
    G = set(gold_atoms)
    tp = len(P & G)
    prec = tp / max(1, len(P))
    rec = tp / max(1, len(G))
    f1 = 2 * prec * rec / max(1e-9, prec + rec)
    return {"precision": prec, "recall": rec, "f1": f1,
            "tp": tp, "n_pred": len(P), "n_gold": len(G),
            "missing": sorted(G - P)[:20], "spurious": sorted(P - G)[:20]}
