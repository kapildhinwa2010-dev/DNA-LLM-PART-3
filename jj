def clean_answer(s: str) -> str:
    s = str(s).strip()
    s = s.split("\n")[0].strip()

    # remove bullets / numbering
    s = re.sub(r"^[-*•\d\)\]]+\s*", "", s).strip()

    # remove quotes
    s = s.strip(" \"'“”‘’").strip()

    s = s.lower()

    # if only placeholders
    if re.fullmatch(r"[_\s\.\-]*", s):
        return ""

    lead_ins = [
        r"^(the\s+)?capital\s+(city\s+)?(of\s+[a-z0-9' -]+\s+)?(is|:)\s*",
        r"^(the\s+)?chemical\s+symbol\s+(for|of\s+[a-z0-9' -]+\s+)?(is|:)\s*",
        r"^(the\s+)?symbol\s+(for|of\s+[a-z0-9' -]+\s+)?(is|:)\s*",
        r"^(the\s+)?atomic\s+number\s+(of\s+[a-z0-9' -]+\s+)?(is|:)\s*",
        r"^(the\s+)?(element\s+)?category\s+(of\s+[a-z0-9' -]+\s+)?(is|:)\s*",
        r"^(it\s+is|is|answer|answer:|response|response:|short answer)\s*:?\s*",
        r"^(located\s+in\s+(the\s+)?(state\s+of\s+|country\s+of\s+)?)",
        r"^(which\s+)?(country|element|continent)\s+is\s*",
    ]

    for p in lead_ins:
        s = re.sub(p, "", s).strip()

    # cut at sentence punctuation
    s = re.split(r"[.;!?\n]+", s)[0]

    # cut at parentheses/brackets
    s = re.split(r"[\(\[\{]", s)[0]

    # strip trailing punctuation
    s = s.strip(" \t,.-:;!?\"'")

    # collapse spaces
    s = re.sub(r"\s+", " ", s).strip()

    # remove leading article
    s = re.sub(r"^(the|a|an)\s+", "", s).strip()

    if re.fullmatch(r"[_\s\.\-]*", s):
        return ""

    return s

def valid_rel_answer(rel: str, ans: str) -> bool:
    if not ans:
        return False

    ans = ans.strip().lower()

    if rel == "symbol_of":
        return bool(re.fullmatch(r"[a-z]{1,2}", ans))

    if rel == "number_of":
        return bool(re.fullmatch(r"\d{1,3}", ans))

    if rel == "category_of":
        return ans in CATEGORY_WHITELIST

    if rel == "continent_of":
        return ans in CONTINENT_WHITELIST

    if rel == "capital_of":
        if len(ans.split()) > 5:
            return False
        if re.search(r"located|state|country|continent|blank|fill|____", ans):
            return False
        return True

    return True

def fallback_extract(rel: str, raw: str) -> str:
    raw = str(raw).strip()
    if not raw:
        return ""

    if rel == "symbol_of":
        # Prefer standalone 1-2 letter symbol-like tokens.
        toks = re.findall(r"\b([A-Za-z]{1,2})\b", raw)
        stop = {"the", "a", "an", "it", "is", "of", "for", "in", "to", "on"}
        for t in toks:
            tl = t.lower()
            if tl in stop:
                continue
            if len(t) <= 2 and (t.isupper() or (len(t) == 2 and t[0].isupper() and t[1].islower())):
                return tl
        c = clean_answer(raw)
        if re.fullmatch(r"[a-z]{1,2}", c):
            return c
        return ""

    if rel == "number_of":
        m = re.search(r"\b(\d{1,3})\b", raw)
        return m.group(1) if m else ""

    if rel == "category_of":
        low = raw.lower()
        for cat in sorted(CATEGORY_WHITELIST, key=len, reverse=True):
            if cat in low:
                return cat
        return ""

    if rel == "continent_of":
        low = raw.lower()
        for cont in sorted(CONTINENT_WHITELIST, key=len, reverse=True):
            if cont in low:
                return cont
        return ""

    if rel == "capital_of":
        # Try pattern: "... is Tokyo" / "... is Mexico City"
        m = re.search(r"\bis\s+([A-Z][A-Za-z .'-]{1,40})", raw)
        if m:
            ans = m.group(1)
            ans = re.split(r"[.;,!?\n]", ans)[0].strip()
            ans = norm(ans)
            if ans and len(ans.split()) <= 5 and not re.search(r"located|state|country|blank|_", ans):
                return ans

        c = clean_answer(raw)
        if valid_rel_answer("capital_of", c):
            return c

        return ""

    c = clean_answer(raw)
    return c if valid_rel_answer(rel, c) else ""

