def extract_atoms(teacher) -> Dict[Tuple[str, str], str]:
    print("\n🔬 Extracting atoms from teacher...")

    buckets = defaultdict(list)
    raw_logs = defaultdict(list)
    total = 0

    for c in CONCEPTS:
        kind = c["kind"]
        name = c["name"]

        for rel, templates in EXTRACTION_TEMPLATES[kind].items():
            for tmpl in templates[:MAX_EXTRACTION_PROMPTS_PER_RELATION]:
                prompt = tmpl.format(name=name)
                raw = teacher.generate(prompt, max_new_tokens=MAX_NEW_TOKENS)
                raw_logs[(name, rel)].append(raw)

                cleaned = clean_answer(raw)
                if valid_rel_answer(rel, cleaned):
                    buckets[(name, rel)].append(cleaned)
                else:
                    fb = fallback_extract(rel, raw)
                    if fb:
                        buckets[(name, rel)].append(fb)

                total += 1
                if total % 20 == 0:
                    print(f"   generated {total} prompts...")

    atoms = {}
    missing = []

    for key, answers in buckets.items():
        if not answers:
            missing.append(key)
            continue

        cnt = Counter(answers)
        modal, n = cnt.most_common(1)[0]
        atoms[key] = modal

    print(f"✅ Extracted {len(atoms)} atoms")
    if missing:
        print(f"⚠️ Missing atoms: {len(missing)}")
        for s, r in missing[:20]:
            print(f"   {s} | {r}")
            for raw in raw_logs[(s, r)][:3]:
                print(f"      raw: {raw}")

    return atoms

